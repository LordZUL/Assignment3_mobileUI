<?xml version="1.0" encoding="utf-8"?>
<!-- Custom recurrence (Google Calendar style) -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp">

        <!-- Repeat every [1] [week] -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Repeat every"
            android:textColor="#787774"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/repeat_interval"
                android:layout_width="64dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="3"
                android:text="1" />

            <Spinner
                android:id="@+id/repeat_unit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Repeat on S M T W T F S (weeks only) -->
        <LinearLayout
            android:id="@+id/repeat_days_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Repeat on"
                android:textColor="#787774"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/repeat_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal" />
        </LinearLayout>

        <!-- Ends -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Ends"
            android:textColor="#787774"
            android:textSize="13sp" />

        <RadioButton
            android:id="@+id/ends_never"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Never" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/ends_on"
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:text="On" />

            <TextView
                android:id="@+id/ends_on_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_field"
                android:paddingHorizontal="12dp"
                android:paddingVertical="8dp"
                android:textColor="#37352F" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <RadioButton
                android:id="@+id/ends_after"
                android:layout_width="96dp"
                android:layout_height="wrap_content"
                android:text="After" />

            <EditText
                android:id="@+id/ends_after_count"
                android:layout_width="56dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:inputType="number"
                android:maxLength="3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="occurrences" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Add Task screen. One vertical container (like the home screen) with these items:
      1. Top bar        - close (X), handle, Save
      2. Title + type   - title field, "Task" chip
      3. Details        - Collaboration, Category, Priority, Status, Location
      4. Date & alerts  - Due Date, repeat, Notification
      5. Description
      6. Extras         - Checklist, Attachment
    Sections are separated by 1dp black dividers. ScrollView keeps it usable on short screens.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9D9D9"
    android:fillViewport="true"
    tools:context=".AddTaskFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="6dp">

        <!-- ===== ITEM 1: Top bar ===== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageButton
                android:id="@+id/close_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="start|center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_close"
                android:contentDescription="Close" />

            <TextView
                android:id="@+id/save_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|center_vertical"
                android:background="@drawable/bg_white_rounded"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Save"
                android:textColor="@color/black"
                android:textSize="15sp" />
        </FrameLayout>

        <!-- ===== ITEM 2: Title + type chip ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingBottom="10dp">

            <EditText
                android:id="@+id/task_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                android:hint="Title *"
                android:inputType="textCapSentences"
                android:paddingVertical="4dp"
                android:textColor="@color/black"
                android:textColorHint="#222222"
                android:textSize="24sp" />

            <TextView
                android:id="@+id/task_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_white_rounded"
                android:paddingHorizontal="10dp"
                android:paddingVertical="2dp"
                android:text="Task"
                android:textColor="@color/black" />
        </LinearLayout>

        <View style="@style/TaskDivider" />

        <!-- ===== ITEM 3: Details ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="6dp">

            <!-- Collaboration: type an email; tapping the field shows recent emails -->
            <LinearLayout
                android:id="@+id/collaboration_row"
                style="@style/TaskRow">
                <TextView style="@style/TaskRowLabel" android:text="Collaboration" />
                <AutoCompleteTextView
                    android:id="@+id/collaboration_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.4"
                    android:background="@android:color/transparent"
                    android:completionThreshold="1"
                    android:dropDownWidth="260dp"
                    android:gravity="end"
                    android:hint="Empty"
                    android:imeOptions="actionDone"
                    android:inputType="textEmailAddress"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="@color/black"
                    android:textColorHint="#8A8A8A"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Added emails appear here as removable chips -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/collaborator_chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="4dp"
                android:visibility="gone"
                app:chipSpacingVertical="0dp" />

            <!-- Category: tap to open the Notion-style dropdown -->
            <LinearLayout
                android:id="@+id/category_row"
                style="@style/TaskRow"
                android:background="?attr/selectableItemBackground">
                <TextView android:id="@+id/category_label" style="@style/TaskRowLabel" android:text="Category *" />
                <TextView android:id="@+id/category_value" style="@style/TaskRowValue" android:text="Empty" />

                <!-- Chosen category: white pill with a coloured dot and an x to clear it -->
                <LinearLayout
                    android:id="@+id/category_pill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="10dp"
                    android:paddingEnd="2dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/category_pill_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="6dp"
                        android:gravity="center_vertical"
                        android:textColor="@color/black"
                        android:textSize="13sp"
                        tools:text="Academic" />

                    <ImageButton
                        android:id="@+id/category_clear"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Clear category"
                        android:src="@drawable/ic_close_small" />
                </LinearLayout>

                <!-- Toggle (Academic only): show / hide Class, Coursework Type, Weight -->
                <ImageButton
                    android:id="@+id/academic_toggle"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pill"
                    android:contentDescription="Hide academic details"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_chevron_right"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Academic details: only shown when Category = Academic -->
            <LinearLayout
                android:id="@+id/academic_fields"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout style="@style/TaskRow">
                    <TextView style="@style/TaskRowLabel" android:text="Class" />
                    <EditText
                        android:id="@+id/class_input"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:background="@android:color/transparent"
                        android:gravity="end"
                        android:hint="Empty"
                        android:imeOptions="actionDone"
                        android:inputType="textCapCharacters"
                        android:padding="0dp"
                        android:singleLine="true"
                        android:textColor="@color/black"
                        android:textColorHint="#8A8A8A"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/coursework_row"
                    style="@style/TaskRow"
                    android:background="?attr/selectableItemBackground">
                    <TextView style="@style/TaskRowLabel" android:text="Coursework Type" />
                    <TextView
                        android:id="@+id/coursework_value"
                        style="@style/TaskRowValue"
                        android:text="Empty" />
                </LinearLayout>

                <LinearLayout style="@style/TaskRow">
                    <TextView style="@style/TaskRowLabel" android:text="Weight" />
                    <EditText
                        android:id="@+id/weight_input"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@android:color/transparent"
                        android:gravity="end"
                        android:hint="Empty"
                        android:imeOptions="actionDone"
                        android:inputType="numberDecimal"
                        android:maxLength="5"
                        android:minWidth="40dp"
                        android:padding="0dp"
                        android:textColor="@color/black"
                        android:textColorHint="#8A8A8A"
                        android:textSize="14sp" />
                    <TextView
                        android:id="@+id/weight_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="2dp"
                        android:text="%"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Priority: tap for High / Medium / Low / None (pill like Status) -->
            <LinearLayout
                android:id="@+id/priority_row"
                style="@style/TaskRow"
                android:background="?attr/selectableItemBackground">
                <TextView style="@style/TaskRowLabel" android:text="Priority" />
                <TextView
                    android:id="@+id/priority_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="2dp"
                    android:text="None"
                    android:textColor="@color/black"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Status: tap for Not Started / In Progress / Completed (pill like Priority) -->
            <LinearLayout
                android:id="@+id/status_row"
                style="@style/TaskRow"
                android:background="?attr/selectableItemBackground">
                <TextView style="@style/TaskRowLabel" android:text="Status" />
                <TextView
                    android:id="@+id/status_chip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:drawableStart="@drawable/status_dot"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="2dp"
                    android:text="Not Started"
                    android:textColor="@color/black"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Location: type straight into the field -->
            <LinearLayout style="@style/TaskRow">
                <TextView style="@style/TaskRowLabel" android:text="Location" />
                <EditText
                    android:id="@+id/location_input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.4"
                    android:background="@android:color/transparent"
                    android:gravity="end"
                    android:hint="Empty"
                    android:imeOptions="actionDone"
                    android:inputType="textPostalAddress|textCapWords"
                    android:padding="0dp"
                    android:singleLine="true"
                    android:textColor="@color/black"
                    android:textColorHint="#8A8A8A"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/TaskDivider" />

        <!-- ===== ITEM 4: Date & alerts ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingVertical="6dp">

            <LinearLayout
                android:id="@+id/due_date_row"
                style="@style/TaskRow"
                android:background="?attr/selectableItemBackground">
                <TextView style="@style/TaskRowLabel" android:text="Due Date" />
                <TextView
                    android:id="@+id/due_date_value"
                    style="@style/TaskRowValue"
                    android:textColor="@color/black"
                    tools:text="Wed, June 13, 2026" />
            </LinearLayout>

            <!-- Due time: tap to pick, x to remove -->
            <LinearLayout style="@style/TaskRow">
                <TextView style="@style/TaskRowLabel" android:text="Due Time" />
                <TextView
                    android:id="@+id/due_time_value"
                    style="@style/TaskRowValue"
                    android:background="?attr/selectableItemBackground"
                    android:text="Add time" />
                <ImageButton
                    android:id="@+id/due_time_clear"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Remove time"
                    android:src="@drawable/ic_close_small"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- Repeat: tap for Does not repeat / Every day / ... / Custom -->
            <LinearLayout
                android:id="@+id/repeat_row"
                style="@style/TaskRow"
                android:background="?attr/selectableItemBackground">
                <TextView
                    android:id="@+id/repeat_value"
                    style="@style/TaskRowLabel"
                    android:drawableStart="@drawable/ic_repeat"
                    android:drawablePadding="4dp"
                    android:text="Does not repeat" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/notification_row"
                style="@style/TaskRow"
                android:background="?attr/selectableItemBackground">
                <TextView
                    style="@style/TaskRowLabel"
                    android:drawableStart="@drawable/ic_bell"
                    android:drawablePadding="4dp"
                    android:text="Notification" />
                <!-- Tap the row for presets or Custom (type the amount) -->
                <TextView
                    android:id="@+id/notification_value"
                    style="@style/TaskRowValue"
                    android:text="30 minutes before"
                    android:textColor="@color/black" />
                <ImageButton
                    android:id="@+id/notification_clear"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="4dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@drawable/ic_close_small"
                    android:contentDescription="Remove notification" />
            </LinearLayout>
        </LinearLayout>

        <View style="@style/TaskDivider" />

        <!-- ===== ITEM 5: Description ===== -->
        <EditText
            android:id="@+id/task_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:gravity="top|start"
            android:hint="Description"
            android:inputType="textMultiLine|textCapSentences"
            android:minLines="2"
            android:paddingHorizontal="4dp"
            android:paddingVertical="10dp"
            android:textColor="@color/black"
            android:textColorHint="#8A8A8A" />

        <View style="@style/TaskDivider" />

        <!-- ===== ITEM 6: Extras ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp"
            android:paddingVertical="12dp">

            <TextView
                android:id="@+id/checklist_button"
                style="@style/TaskExtraButton"
                android:drawableStart="@drawable/ic_checklist"
                android:text="Checklist" />

            <TextView
                android:id="@+id/attachment_button"
                style="@style/TaskExtraButton"
                android:layout_marginStart="8dp"
                android:drawableStart="@drawable/ic_attach"
                android:text="Attachment" />
        </LinearLayout>

        <!-- ===== Attachments - shown after tapping Attachment; X closes it ===== -->
        <LinearLayout
            android:id="@+id/attachment_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingBottom="12dp"
            android:visibility="gone">

            <!-- Header: Attachments   [Add file] [X] -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_attach" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Attachments"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/attachment_add_more"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_white_rounded"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Add file"
                    android:textColor="@color/black" />

                <ImageButton
                    android:id="@+id/attachment_exit"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="6dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close attachments"
                    android:src="@drawable/ic_close" />
            </LinearLayout>

            <TextView
                android:id="@+id/attachment_empty"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="No files yet"
                android:textColor="#8A8A8A"
                android:textSize="13sp" />

            <!-- Attached files appear here (tap to open, x to remove) -->
            <LinearLayout
                android:id="@+id/attachment_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- ===== Checklist (Trello style) - hidden until the Checklist button is tapped ===== -->
        <LinearLayout
            android:id="@+id/checklist_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingBottom="16dp"
            android:visibility="gone">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_checklist" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Checklist"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/checklist_delete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_white_rounded"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="Delete"
                    android:textColor="@color/black" />
            </LinearLayout>

            <!-- Progress: 0% [==========] -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/checklist_percent"
                    android:layout_width="38dp"
                    android:layout_height="wrap_content"
                    android:text="0%"
                    android:textColor="#44546F"
                    android:textSize="11sp" />

                <ProgressBar
                    android:id="@+id/checklist_progress"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="0dp"
                    android:layout_height="8dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/progress_checklist" />
            </LinearLayout>

            <!-- Items get added here in code -->
            <LinearLayout
                android:id="@+id/checklist_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="vertical" />

            <!-- "Add an item" box: Add / Cancel / Assign / Due date -->
            <LinearLayout
                android:id="@+id/checklist_add_area"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="38dp"
                android:layout_marginTop="6dp"
                android:orientation="vertical">

                <EditText
                    android:id="@+id/checklist_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_checklist_input"
                    android:gravity="top|start"
                    android:hint="Add an item"
                    android:inputType="textCapSentences|textMultiLine"
                    android:minLines="2"
                    android:padding="10dp"
                    android:textColor="@color/black"
                    android:textColorHint="#626F86"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/checklist_add"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_button_blue"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"
                        android:text="Add"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/checklist_cancel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="6dp"
                        android:text="Cancel"
                        android:textColor="#172B4D"
                        android:textStyle="bold" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/checklist_assign"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="?attr/selectableItemBackground"
                        android:drawableStart="@drawable/ic_person_add"
                        android:drawablePadding="4dp"
                        android:ellipsize="end"
                        android:gravity="center_vertical"
                        android:maxWidth="110dp"
                        android:maxLines="1"
                        android:padding="4dp"
                        android:text="Assign"
                        android:textColor="#44546F"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/checklist_due"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:background="?attr/selectableItemBackground"
                        android:drawableStart="@drawable/ic_clock"
                        android:drawablePadding="4dp"
                        android:gravity="center_vertical"
                        android:maxLines="1"
                        android:padding="4dp"
                        android:text="Due date"
                        android:textColor="#44546F"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Shown after Cancel, to open the add box again -->
            <TextView
                android:id="@+id/checklist_show_add"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="38dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_white_rounded"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Add an item"
                android:textColor="#172B4D"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
